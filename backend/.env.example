# Copy to .env and fill in. .env is gitignored (holds secrets).

# --- Core ---
# Set DEBUG=true only for local development. With DEBUG=false the app REFUSES to
# start while JWT_SECRET is still the default — set a strong random secret below.
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:8000
# Behind a reverse proxy, list the proxy's source IP(s) that may set
# X-Forwarded-For; otherwise client IPs (rate-limit / audit) can be spoofed.
# TRUSTED_PROXY_IPS=10.0.0.1

# --- Datastores ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_studio
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string

# --- Model gateway (your existing gateway) ---
GATEWAY_BASE_URL=https://your-gateway
GATEWAY_API_KEY=sk-xxxxxxxx
# Normal chat/reverse gateway calls can stay shorter; render endpoints below
# are intentionally wider because large images/videos may take minutes.
# GATEWAY_TIMEOUT_SECONDS=120
# IMAGE_GATEWAY_TIMEOUT_SECONDS=600
# IMAGE_DOWNLOAD_TIMEOUT_SECONDS=600
# Set true to run fully offline with placeholder media (no gateway calls):
MOCK_MODE=false
# Image-to-image edit endpoint for reverse-off (图+指令→图). Default /v1/images/edits.
# If your gateway has NO such endpoint, set empty to force plain text->image:
# IMAGE_EDIT_PATH=
# Keyframes sampled from a reference video for understanding (needs ffmpeg):
# REVERSE_VIDEO_FRAMES=4

# --- Video gateway (optional; defaults to the main gateway if left blank) ---
# For Volcengine Ark / Doubao Seedance:
VIDEO_GATEWAY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_GATEWAY_API_KEY=ark-xxxxxxxx
VIDEO_GATEWAY_FORMAT=ark
# Video submit is usually quick, but provider-side queueing can make it slow.
# VIDEO_SUBMIT_TIMEOUT_SECONDS=300
# Video polling total render window. Keep CELERY_TASK_TIME_LIMIT_SECONDS above
# the longest expected task window.
# VIDEO_POLL_MAX_SECONDS=1800
# VIDEO_POLL_INTERVAL_SECONDS=5
# VIDEO_DOWNLOAD_MAX_ATTEMPTS=5
# CELERY_TASK_TIME_LIMIT_SECONDS=2700

# --- Limits / retention (sane defaults; tune as needed) ---
# MAX_IMAGE_N=8                 # max images per generation
# MAX_IMAGE_DIM=4096            # max requested width/height
# MAX_VIDEO_SECONDS=30          # max requested clip length
# USER_GEN_RATE_PER_HOUR=60     # per-user generation rate limit
# USER_PARSE_RATE_PER_HOUR=60   # per-user link-parse rate limit
# PARSE_PLAYWRIGHT_PARALLELISM=2
# PARSE_PLAYWRIGHT_ACQUIRE_TIMEOUT_SECONDS=8
# PARSE_MAX_RAW_BODY_BYTES=3000000
# PARSE_MAX_RENDER_HTML_BYTES=8000000
# PARSE_LOCALIZE_IMAGE_MAX_BYTES=20971520
# PARSE_LOCALIZE_IMAGE_MAX_PIXELS=50000000
# GENERATED_IMAGE_MAX_PIXELS=50000000
# MAX_UPLOAD_IMAGE_BYTES=20971520
# MAX_UPLOAD_IMAGE_PIXELS=50000000
# ASSET_RETENTION_DAYS=30       # generated assets kept this long
# PARSE_RETENTION_DAYS=7        # link-parse records kept this long

# --- Observability (optional) ---
# SENTRY_DSN=                   # set to enable Sentry (needs sentry-sdk installed)
# Required when DEBUG=false because prometheus-client is installed.
METRICS_TOKEN=please-change-me-to-a-long-random-metrics-token

# --- SMS (mock returns the code in the API response for local dev) ---
# Local development may use mock. Production DEBUG=false refuses mock.
# Recommended production path: put your real SMS service behind an HTTPS
# endpoint and set SMS_PROVIDER=http + SMS_HTTP_URL below. Aliyun/Tencent SDK
# providers are not enabled until implemented in code.
SMS_PROVIDER=mock
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_TIMEOUT_SECONDS=10

# --- Payments / credit recharge ---
# Local DEBUG can use mock QR orders and the "simulate paid" button. Keep false
# in any shared or production deployment.
PAYMENT_MOCK_ENABLED=false
PAYMENT_ORDER_EXPIRE_MINUTES=30
PAYMENT_FRONTEND_BASE_URL=http://localhost:3000
PAYMENT_SUBJECT_PREFIX=造梦 Studio 积分充值
# Strong random secret used to encrypt merchant keys saved from the admin UI.
# Required for production if payment configs are managed in the database.
PAYMENT_CONFIG_SECRET=

# Alipay face-to-face QR payment. Required when PAYMENT_MOCK_ENABLED=false and
# provider=alipay. Keys can use escaped \n in .env.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# WeChat Pay API v3 Native QR payment. Required when PAYMENT_MOCK_ENABLED=false
# and provider=wechat.
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PEM=
WECHAT_PAY_NOTIFY_URL=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# --- Storage (local FS for the bare-metal MVP) ---
# STORAGE_DIR defaults to backend/storage
