# Set a non-empty key for every networked deployment.
ASR_PROVIDER_API_KEY=replace-with-a-long-random-secret

# Keep this exactly equal to AUDIO_TRANSCRIPTION_MODEL in the consuming backend.
ASR_PROVIDER_MODEL=small
ASR_PROVIDER_DEVICE=cpu
ASR_PROVIDER_COMPUTE_TYPE=int8
ASR_PROVIDER_EAGER_LOAD=true

# The backend's extracted MP3 must fit below this cap.
ASR_PROVIDER_MAX_UPLOAD_BYTES=50331648
ASR_PROVIDER_MAX_SEGMENTS=1000
ASR_PROVIDER_BEAM_SIZE=5
